{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // 这份要 DOM：有的测试直接 import 插件的浏览器侧（`plugins/shell/tests/well-hub.test.ts` 引入
    // `src/client/types.ts`，那份用了 `HTMLElement`），base 的 lib 只有 ES2023，不加 DOM 仓根的 tsc 报 TS2304。
    // 加 DOM 只影响这份的全局声明，不影响任何产物（这份 noEmit）
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  // 各插件包的 tsconfig 只收 src；插件的 tests 与构建脚本在这儿按通配收，新插件的自动进来
  "include": ["vitest.config.ts", "plugins/*/tests/**/*.ts", "plugins/*/build.ts"]
}
