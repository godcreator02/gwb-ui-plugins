{
  "name": "@godcreator/gwb-shell",
  "version": "0.15.10",
  "description": "外壳：内核页面根的唯一入口，提供窗格容器与窗格注册服务 gwbShell，并随包提供令牌表和 UI 接入说明书",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./theme.reference.css": "./dist/theme.reference.css",
    "./pane": {
      "types": "./dist/types/client/pane-api.d.ts"
    },
    "./browser-imports": {
      "types": "./dist/browser-imports.d.ts",
      "default": "./dist/browser-imports.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.build.json && tsc -p src/client/tsconfig.pane-types.json && tailwindcss -i src/client/styles.css -o dist/style.css",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "@godcreator/gwb-commands": "^0.6.0",
    "@godcreator/gwb-data": "^0.1.7",
    "@godcreator/gwb-skills": "^0.4.5",
    "cordis": "^4.0.0-rc.10"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "cordis": "4.0.0-rc.10",
    "dockview-react": "8.2.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.41.0",
    "postcss": "^8.5.28",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-ui-plugins.git"
  },
  "keywords": [
    "gwb-plugin"
  ]
}
