{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    // 浏览器侧没有 node 全局：不给空表的话 @types/node 会自动收进来，
    // 写一句 process.env 也不报错，而产物里根本没有它
    "types": [],
    "noEmit": true,
    // shadcn 添加的组件写的是 @/… 这种，typecheck 要解析得了。
    // 不写 baseUrl：TS 7 移除了它，paths 相对本文件所在目录解析
    "paths": {
      "@/*": ["./*"]
    }
  },
  // 纯逻辑模块在 src/（node 侧也用），浏览器侧 import 它们，
  // tsc 顺着 import 自己拉进来
  "include": ["."]
}
