{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // 只给 shadcn CLI 看：它读插件包根的 tsconfig 解析 components.json 里的 @/ 别名，
    // 据此决定把拉下来的组件放到哪。node 侧自己一个 @/ 都不用。
    // 不写 baseUrl——TS 7 把它移除了（TS5102），paths 现在直接相对本文件所在目录解析
    "paths": {
      "@/*": ["./src/client/*"]
    }
  },
  // 只收 src 顶层那一层（`src/*.ts` 不是 `src/**/*.ts`）：浏览器侧在 src/client/，
  // 它用 document、走另一份 tsconfig（jsx + DOM + 无 node 全局）。收进来的话
  // node 侧的 lib 里没有 DOM，当场报一片错。tests 与 build.ts 由仓根 tsconfig.json 收
  "include": ["src/*.ts"]
}
