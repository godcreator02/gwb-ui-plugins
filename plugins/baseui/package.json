{
  "name": "@godcreator/gwb-baseui",
  "version": "0.1.20",
  "description": "基础界面：基础插件的官方窗格集（日志、插件管理），一个窗格一个模块，只收拆掉了界面的基础插件的窗格",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.ts && tailwindcss -i src/client/styles.css -o dist/style.css",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.8.0",
    "@godcreator/gwb-shell": "workspace:*",
    "@godcreator/gwb-logger": "^0.4.5",
    "@godcreator/gwb-plugin-manager": "^0.14.3"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-logger": {
      "optional": true
    },
    "@godcreator/gwb-plugin-manager": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-ui-plugins.git"
  },
  "keywords": [
    "gwb-plugin"
  ]
