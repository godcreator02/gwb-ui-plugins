{
  "name": "@godcreator/gwb-baseui",
  "version": "0.1.1",
  "author": {"name": "godcreator"},
  "description": "基础界面：基础插件的官方窗格集（日志、插件管理），一窗格一模块；硬注入只有 gwbShell，对 core 服务（gwbLogger、gwbPluginManager）一律嵌套注入；只收「劈过插件的界面」，UI 即本体的插件不进。服务无；skill 0 份；命令 0 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "//gwb": "整段没有。浏览器半与样式表的地址由 node 半从 import.meta.url 算成 file://，随 registerPane 交出去；这个件不是共享包，gwb.shared 没人读",
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.ts && tailwindcss -i src/client/styles.css -o dist/style.css",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json",
    "//prepublishOnly": "发版前强制构建一次。pnpm check 只跑 typecheck/lint/test 不构建，少了这条就会把上一版的 dist 原样发出去——而且是静默的",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-logger": "^0.4.1",
    "@godcreator/gwb-plugin-api": "^0.1.2",
    "@godcreator/gwb-plugin-manager": "^0.5.3",
    "@godcreator/gwb-shared-react": "^0.1.1",
    "@godcreator/gwb-shell": "^0.9.2",
    "@godcreator/gwb-tokens": "^0.1.4",
    "cordis": "^4.0.0-rc.9"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-logger": {
      "optional": true
    },
    "@godcreator/gwb-plugin-manager": {
      "optional": true
    }
  },
  "devDependencies": {
    "@godcreator/gwb-logger": "0.4.1",
    "@godcreator/gwb-plugin-api": "0.1.2",
    "@godcreator/gwb-plugin-manager": "0.5.3",
    "@godcreator/gwb-repo-kit": "0.2.3",
    "@godcreator/gwb-shared-react": "workspace:*",
    "@godcreator/gwb-shell": "workspace:*",
    "@godcreator/gwb-tokens": "workspace:*",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/node": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "cordis": "4.0.0-rc.9",
    "esbuild": "^0.27.0",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-ui-plugins.git"
  },
  "keywords": ["gwb", "gwb-plugin"]
}
