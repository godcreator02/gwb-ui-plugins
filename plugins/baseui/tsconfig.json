{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // 只给 shadcn CLI 看：它读插件包根的 tsconfig 解析 components.json 里的 @/ 别名，
    // 据此决定把拉下来的组件放到哪。node 侧自己一个 @/ 都不用。
    // 不写 baseUrl——TS 7 把它移除了（TS5102），paths 现在直接相对本文件所在目录解析
    "paths": {
      "@/*": ["./src/client/*"]
    }
  },
  // 只收 src/index.ts：写成 src/**/*.ts 会把浏览器侧的文件也收进来，它们走 src/client/tsconfig.json。
  // tests 与 build.ts 由仓根 tsconfig.json 收
  "include": ["src/index.ts"]
}
