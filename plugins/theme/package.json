{
  "name": "@godcreator/gwb-theme",
  "version": "0.3.15",
  "description": "外观插件：正文字体、等宽字体与自定义 CSS 的全局启动样式表，外加「外观」窗格，没有外壳也照常加载",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.ts && tailwindcss -i src/client/styles.css -o dist/style.css",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.9.0",
    "@godcreator/gwb-commands": "^0.5.6",
    "@godcreator/gwb-settings": "^0.3.3",
    "@godcreator/gwb-shell": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-shell": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-ui-plugins.git"
  },
  "keywords": [
    "gwb-plugin"
  ]
}
