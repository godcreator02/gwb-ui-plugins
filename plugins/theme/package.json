{
  "name": "@godcreator/gwb-theme",
  "version": "0.3.2",
  "author": {
    "name": "godcreator"
  },
  "description": "外观件：全局启动样式表与外观窗格；没外壳也照常挂，样式由件自己编自己那张表（类名 theme: 前缀围栏）。服务无；skill 0；命令 3 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "catalog.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.ts && tailwindcss -i src/client/styles.css -o dist/style.css",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-plugin-api": "^0.1.2",
    "@godcreator/gwb-commands": "^0.4.3",
    "@godcreator/gwb-settings": "^0.2.1",
    "@godcreator/gwb-shared-react": "^0.1.0",
    "@godcreator/gwb-shell": "^0.9.1",
    "@godcreator/gwb-tokens": "^0.1.3"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-shell": {
      "optional": true
    }
  },
  "devDependencies": {
    "@godcreator/gwb-plugin-api": "0.1.2",
    "@godcreator/gwb-commands": "0.4.3",
    "@godcreator/gwb-settings": "0.2.1",
    "@godcreator/gwb-shell": "workspace:*",
    "@godcreator/gwb-shared-react": "workspace:*",
    "@godcreator/gwb-tokens": "workspace:*",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/node": "^4.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "esbuild": "^0.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-ui-plugins.git"
  },
  "keywords": ["gwb", "gwb-plugin"]
}
