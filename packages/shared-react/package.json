{
  "name": "@godcreator/gwb-shared-react",
  "version": "0.1.0",
  "author": {"name": "godcreator"},
  "description": "react 系运行时环境：react / react-dom 四个裸名的 CJS→ESM 束，经页面 importmap 全页同一份实例。",
  "type": "module",
  "exports": {
    "./react": "./dist/react.js",
    "./react-jsx-runtime": "./dist/react-jsx-runtime.js",
    "./react-dom": "./dist/react-dom.js",
    "./react-dom-client": "./dist/react-dom-client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "//gwb.shared": "提供方声明「我给页面提供这几个裸名」，值是本包的 exports 子路径。内核扫 home 清单收齐所有声明拼成 importmap——它不认识 react 这个词，只搬运声明。一个裸名只许一个提供方，撞了内核报出来",
  "gwb": {
    "shared": {
      "react": "./react",
      "react/jsx-runtime": "./react-jsx-runtime",
      "react-dom": "./react-dom",
      "react-dom/client": "./react-dom-client"
    }
  },
  "scripts": {
    "build": "node build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "esbuild": "^0.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-ui-plugins.git"
  },
  "keywords": ["gwb"]
}
