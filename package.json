{
  "name": "gwb-ui-plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./plugins/*\" build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --no-bail typecheck",
    "lint": "oxlint . --type-aware --deny-warnings",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "doc": "pnpm --dir docs-site run doc",
    "doc:render": "pnpm --dir docs-site run doc:render"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
